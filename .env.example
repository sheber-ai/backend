# App
APP_ENV=local
APP_DEBUG=true
APP_CORS_ORIGINS=["http://localhost:5173"]

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=sheber
DB_PASSWORD=sheber
DB_NAME=sheber
DB_ECHO=false

# Keycloak (local: ../keycloak-theme, make up)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=sheber
KEYCLOAK_AUDIENCE=sheber-backend
KEYCLOAK_SWAGGER_CLIENT_ID=sheber-frontend
# Service account that grants the contractor role (realm/sheber-realm.json in ../keycloak-theme)
KEYCLOAK_SERVICE_CLIENT_ID=sheber-backend
KEYCLOAK_SERVICE_CLIENT_SECRET=sheber-backend-local-secret

# Uploaded files (local disk; see docs in ../docs/file-storage.md)
FILES_STORAGE_DIR=var/files
FILES_SIGNING_KEY=change-me-to-a-long-random-string
FILES_URL_TTL_SECONDS=3600
FILES_PUBLIC_BASE_URL=http://localhost:8000

# Link import: reads of shop pages per user within the window (PostgreSQL-backed, no Redis needed)
IMPORTS_RATE_LIMIT=20
IMPORTS_RATE_WINDOW_SECONDS=600
